# Copy this file to .env and fill in real values.
# .env is gitignored and is loaded by both the backend (pydantic-settings)
# and Docker (--env-file .env in the start scripts).

# OpenRouter API key used for LLM calls via the Cerebras inference provider
# (see CLAUDE.md's "AI design" section).
OPENROUTER_API_KEY=

# Secret used to sign JWT access tokens. Set this to a long random string
# for anything beyond local development (e.g. `openssl rand -hex 32`).
SECRET_KEY=
